PROJECT_NAME="AUREX AI"
TAGLINE="The Gold Standard of Brand Integrity"
VERSION="1.0.0"

# Application Environment: 'development', 'staging', or 'production'
ENVIRONMENT="development"

# Database: SQLite by default; use postgresql://user:password@localhost:5432/aurex for PostgreSQL
DATABASE_URL="sqlite:///./aurex_ai.db"

# JWT Security
# Generate a cryptographically secure 256-bit secret (e.g. `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET_KEY="CHANGE_ME_GENERATE_A_SECURE_RANDOM_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API (Optional)
# Leave placeholder to use local deterministic governance engine; add key for live Gemini 2.5 Flash RAG
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Uploads Storage Directory
UPLOAD_DIR="./uploads"

